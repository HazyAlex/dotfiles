" -----------------------
"  Compatibility / Theme
" -----------------------
let mapleader = " "

set backspace=indent,eol,start
set encoding=utf-8

set termguicolors

set guioptions-=m
set guioptions-=T
set guioptions-=r
set guioptions-=L

syntax on

set cursorline

set background=dark
colorscheme OceanicNext
set guifont=Iosevka\ Term:h14


" Resize splits when the window is resized
au VimResized * exe "normal! \<c-w>="

" --------
"  TYPING
" --------
filetype indent plugin on

set tabstop=4
set shiftwidth=4
set softtabstop=4

set autoindent
set smarttab
set expandtab
set smartindent
set ai

set relativenumber
set nu

set showmatch

set incsearch
set hlsearch

set noesckeys

" ---------------------------------------
"  Turn persistent undo on
"  Undo even when you close a buffer/VIM
" ---------------------------------------
set backupdir=~/.vim/temp_dirs/backupdir
set directory=~/.vim/temp_dirs/backupdir

try
    set undodir=~/.vim/temp_dirs/undodir
    set undofile
catch
endtry


" --------
"   MAPS
" --------

" Move visual blocks with > and <
vnoremap < <gv
vnoremap > >gv

" Move vertically by visual line
nnoremap j gj
nnoremap k gk

" Disable Ex-mode
map q: <nop>
nnoremap Q <nop>

inoremap <F1> <ESC>
nnoremap <F1> <ESC>
vnoremap <F1> <ESC>
