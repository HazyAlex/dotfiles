    //
    // ----------------------------
    //  Telemetry and Auto-updates
    // ----------------------------
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.enableExperiments": false,
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "extensions.ignoreRecommendations": true,
    "update.mode": "manual",
    "update.showReleaseNotes": true,
    "telemetry.telemetryLevel": "off",
    "npm.fetchOnlinePackageInfo": false,
    "security.workspace.trust.untrustedFiles": "open",
    // ----------
    //  Terminal
    // ----------
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": [
                "-NoLogo"
            ]
        }
    },
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "overviewRuler",
    "terminal.integrated.localEchoLatencyThreshold": -1,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.showLinkHover": true,
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.fontSize": 16,
    "terminal.fontFamily": "Fira Mono Retina",
    "terminal.integrated.fontFamily": "Fira Mono Retina",
    "terminal.integrated.fontWeight": "300",
    "terminal.integrated.fontWeightBold": "400",
    // --------
    //  Window
    // --------
    "window.restoreWindows": "none",
    "window.customMenuBarAltFocus": false,
    "window.title": "${dirty}${activeFolderShort}/${activeEditorShort}${separator}${rootNameShort}${separator}",
    "window.commandCenter": false,
    "window.titleBarStyle": "custom",
    // -----------
    //  Workbench
    // -----------
    "workbench.colorTheme": "Rosé Pine Moon",
    "workbench.reduceMotion": "on",
    "workbench.panel.opensMaximized": "preserve",
    "workbench.startupEditor": "none",
    "workbench.editor.tabSizing": "shrink",
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.settings.editor": "json",
    "workbench.list.smoothScrolling": false,
    "workbench.sideBar.location": "right",
    "workbench.panel.defaultLocation": "right",
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.stickyScrollMaxItemCount": 7,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.layoutControl.enabled": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.activityBar.location": "hidden",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.colorCustomizations": {
        "[Relaxed]": {
            "textLink.activeForeground": "#e06c75",
            "textLink.foreground": "#41a6d9"
        },
        "[Quiet Light]": {
            "statusBar.background": "#ede8ef",
            "statusBar.foreground": "#5e5e5e"
        },
        "[Snazzy Light]": {
            "statusBar.background": "#3a3a3a",
            "terminal.ansiBrightBlack": "#008f00",
            "terminal.ansiBrightYellow": "#cf9000",
            "terminal.ansiBrightGreen": "#444444"
        },
        "[Kary Pro Colors － Dark]": {
            "dropdown.background": "#202020",
            "statusBar.background": "#1A1A1A",
            "statusBar.foreground": "#CECECE",
            "statusBar.noFolderBackground": "#1A1A1A",
            "statusBar.noFolderForeground": "#CECECE",
            //"tab.activeBorder": "#1A1ABF",
            "editorCursor.background": "#1A1A1A",
            "terminal.background": "#1A1A1A",
            "menu.foreground": "#CECECE"
        },
        "[Kary Pro Colors － Light]": {
            "menu.background": "#F7F7F7",
            "statusBar.background": "#F7F7F7",
            "statusBar.foreground": "#000",
            "statusBar.noFolderBackground": "#F7F7F7",
            "statusBar.noFolderForeground": "#000",
            "editorCursor.foreground": "#313131",
            "terminal.background": "#F7F7F7",
            "terminalCursor.foreground": "#313131"
        },
    },
    "editor.tokenColorCustomizations": {
        "[Make Apps Theme]": {
            "comments": {
                "foreground": "#6C7A80",
                "fontStyle": ""
            }
        },
        "[Yi Light]": {
            "comments": "#be2020"
        },
        "[Tokyo Night Storm]": {
            "comments": "#b5dbe8"
        },
        "[Kary Pro Colors － Light]": {
            "comments": "#A7A4A2"
        }
    },
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": true,
    "explorer.incrementalNaming": "simple",
    "explorer.autoRevealExclude": {
        "**/node_modules": true,
        "**/vendor": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "vendor": true,
        "**/dist": true,
        "**/target/**": true
    },
    "chat.commandCenter.enabled": false,
    "scm.alwaysShowRepositories": true,
    "search.quickOpen.history.filterSortOrder": "recency",
    "search.decorations.badges": false,
    "editor.definitionLinkOpensInPeek": false,
    // --------
    //  Editor
    // --------
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "block",
    "editor.renderLineHighlight": "gutter",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.multiCursorPaste": "spread",
    "editor.snippetSuggestions": "inline",
    "editor.suggestSelection": "first",
    "editor.suggest.insertMode": "insert",
    "editor.autoClosingDelete": "always",
    "editor.matchBrackets": "never",
    "editor.minimap.enabled": false,
    "editor.folding": true,
    "editor.suggest.selectionMode": "always",
    "editor.scrollBeyondLastLine": true,
    "editor.codeLens": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.renderWhitespace": "trailing",
    "editor.lightbulb.enabled": "off",
    "editor.fontFamily": "Iosevka",
    "editor.fontSize": 21,
    "editor.fontLigatures": true,
    "editor.accessibilitySupport": "off",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 0,
    "editor.bracketPairColorization.enabled": false,
    "editor.language.colorizedBracketPairs": [],
    "editor.guides.highlightActiveBracketPair": false,
    "editor.guides.bracketPairs": false,
    "editor.guides.indentation": false,
    "editor.suggest.preview": true,
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.stickyScroll.enabled": false,
    "editor.hover.sticky": true,
    "breadcrumbs.enabled": false,
    // -----
    //  Vim
    // -----
    "editor.lineNumbers": "relative",
    "vim.cursorStylePerMode.insert": "line",
    "vim.foldfix": true,
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.color": "rgba(250, 250, 100, 0.3)",
    "vim.highlightedyank.duration": 280,
    "vim.useCtrlKeys": true,
    "vim.leader": "<space>",
    "vim.useSystemClipboard": false,
    "vim.smartRelativeLine": true,
    "vim.visualModeKeyBindings": [
        {
            "before": [
                "g",
                "y",
                "c"
            ],
            "commands": [
                "editor.action.copyLinesDownAction",
                "editor.action.commentLine",
                "cancelSelection",
                "extension.vim_escape",
                "extension.vim_down"
            ]
        }
    ],
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1,
    },
    // ------------
    //  Error Lens
    // ------------
    "errorLens.enabled": true,
    "errorLens.delay": 0,
    "errorLens.enabledDiagnosticLevels": [
        "warning",
        "info",
        "error"
    ],
    // "errorLens.codeLensEnabled": true,
    // "errorLens.codeLensOnClick": "showQuickFix",
    // -------------------
    //  Language settings
    // -------------------
    "eslint.validate": [
        "javascript",
        "js",
        "vue",
        "typescript",
    ],
    "eslint.format.enable": true,
    "files.associations": {
        "*.json": "jsonc"
    },
    // -----------
    //  TODO Tree
    // -----------
    "todo-tree.regex.regex": "(//)\\s*($TAGS).*(\\r\\n\\s*//\\s{2,}.*)*",
    "todo-tree.ripgrep.ripgrepMaxBuffer": 2048,
    "todo-tree.highlights.highlightDelay": 0,
    "todo-tree.regex.regexCaseSensitive": false,
    "todo-tree.tree.scanMode": "open files",
    "todo-tree.filtering.includeHiddenFiles": true,
    "todo-tree.general.schemes": [
        "vscode-userdata",
        "file",
        "ssh",
        "untitled"
    ],
    // TODO: Read through all of the issues on the github -> look for 'nested' TODOs
    "todo-tree.general.tags": [
        "BUG:",
        "FIXME:",
        "TODO:",
        "@Performance",
        "@Internal",
        "@Measure",
        "@Debug",
        "@Note"
    ],
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag-and-subTag",
        "foreground": "#9DE3C0",
        "borderRadius": "0px",
    },
    "todo-tree.highlights.customHighlight": {
        "@Internal": {
            "type": "tag-and-subTag",
            "foreground": "#d00",
            "background": "#ffffff00",
        },
        "TODO:": {
            "type": "text-and-comment",
            "foreground": "#ff0",
            "background": "#ffffff00",
        },
        "FIXME:": {
            "type": "text-and-comment",
            "foreground": "#ccc",
            "background": "#ff777788",
        }
    },
    // -----
    //  Git
    // -----
    "git.branchProtection": [
        "main",
        "master",
        "staging",
        "develop",
    ],
    // ------------------
    //  Markdown / Notes
    // ------------------
    "markdown.validate.enabled": true,
    "pasteImage.path": "${currentFileDir}",
    "pasteImage.showFilePathConfirmInputBox": true,
    "markdown.preview.breaks": true,
    "[plaintext]": {
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off",
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        }
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off",
        "editor.overviewRulerBorder": false,
        "editor.lineHeight": 28,
        "editor.wrappingIndent": "indent",
        "workbench.editor.languageDetection": false,
    },
    "[org]": {
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off"
    },
    // ---------
    //  Preview
    // ---------
    "editor.cursorSmoothCaretAnimation": "off", // TODO: Too slow.
    "editor.experimental.asyncTokenization": true,
    "editor.experimental.asyncTokenizationLogging": false,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "g",
                "u",
            ],
            "commands": [
                "workbench.action.navigateBack"
            ]
        },
        {
            "before": [
                "g",
                "h"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ]
        },
        {
            "before": [
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "D"
            ],
            "commands": [
                "editor.action.revealDefinitionAside"
            ]
        },
        {
            "before": [
                "g",
                "p",
                "d"
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "p",
                "i"
            ],
            "commands": [
                "editor.action.peekImplementation"
            ]
        },
        {
            "before": [
                "g",
                "q"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "before": [
                "g",
                "t"
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "g",
                "p",
                "t"
            ],
            "commands": [
                "editor.action.peekTypeDefinition"
            ]
        },
    ],
}